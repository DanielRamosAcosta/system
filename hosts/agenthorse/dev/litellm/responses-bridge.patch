+                    part for part in (_text(_field(previous, "content")), _text(_field(message, "content"))) if part
+                )
+                if isinstance(previous, dict):
+                    previous["content"] = text or None
+                else:
+                    setattr(previous, "content", text or None)
+                continue
+            merged.append(message)
